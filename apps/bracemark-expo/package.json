{
  "name": "@stxapps/bracemark-expo",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prebuild": "expo prebuild --clean",
    "start": "expo start",
    "start:lan": "EXPO_PUBLIC_API_URL=http://$(scutil --get LocalHostName).local:8787 EXPO_PUBLIC_SITE_URL=http://$(scutil --get LocalHostName).local:3001 expo start",
    "start:staging": "EXPO_PUBLIC_API_URL=https://api.dryrunbase.com EXPO_PUBLIC_SITE_URL=https://dryrunbase.com expo start",
    "start:production": "EXPO_PUBLIC_API_URL=https://api.bracemark.com EXPO_PUBLIC_SITE_URL=https://bracemark.com expo start",
    "android": "expo run:android",
    "android:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8787 tcp:8787 && adb reverse tcp:8788 tcp:8788",
    "android:open": "adb shell am start -a android.intent.action.VIEW -d bracemark://expo-development-client/?url=http%3A%2F%2Flocalhost%3A8081%2F%3FdisableOnboarding%3D1",
    "android:release": "rm -rf android/app/build/generated/assets/createBundleReleaseJsAndAssets && expo run:android --variant release",
    "android:release:staging": "rm -rf android/app/build/generated/assets/createBundleReleaseJsAndAssets && BRACEMARK_NONPROD_RELEASE=1 EXPO_PUBLIC_API_URL=https://api.dryrunbase.com EXPO_PUBLIC_SITE_URL=https://dryrunbase.com expo run:android --variant release",
    "android:bundle": "cd android && ./gradlew :app:createBundleReleaseJsAndAssets --rerun :app:bundleRelease && node ../../../tools/scripts/check-native-bundle.mjs app/build/outputs/bundle/release/app-release.aab",
    "ios": "expo run:ios",
    "ios:lan": "EXPO_PUBLIC_API_URL=http://$(scutil --get LocalHostName).local:8787 EXPO_PUBLIC_SITE_URL=http://$(scutil --get LocalHostName).local:3001 expo run:ios --device",
    "ios:open": "xcrun simctl openurl booted bracemark://expo-development-client/?url=http%3A%2F%2Flocalhost%3A8081%2F%3FdisableOnboarding%3D1",
    "ios:release": "expo run:ios --configuration Release --device",
    "ios:release:staging": "BRACEMARK_NONPROD_RELEASE=1 EXPO_PUBLIC_API_URL=https://api.dryrunbase.com EXPO_PUBLIC_SITE_URL=https://dryrunbase.com expo run:ios --configuration Release --device",
    "ios:bundle": "bash ../../tools/scripts/ios-bundle.sh",
    "ios:upload": "bash ../../tools/scripts/ios-upload.sh",
    "ios:check-archive": "node ../../tools/scripts/check-native-bundle.mjs --latest-archive"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:expo"
    ],
    "targets": {
      "start": {
        "continuous": true
      },
      "android": {
        "continuous": true
      },
      "ios": {
        "continuous": true
      }
    }
  },
  "dependencies": {
    "@craftzdog/react-native-buffer": "*",
    "@expo/metro-config": "*",
    "@hookform/resolvers": "*",
    "@react-native-community/datetimepicker": "*",
    "@react-native-community/netinfo": "*",
    "@react-navigation/drawer": "*",
    "@react-navigation/native": "*",
    "@rn-primitives/alert-dialog": "*",
    "@rn-primitives/checkbox": "*",
    "@rn-primitives/dialog": "*",
    "@rn-primitives/dropdown-menu": "*",
    "@rn-primitives/portal": "*",
    "@rn-primitives/radio-group": "*",
    "@rn-primitives/slot": "*",
    "@rn-primitives/tabs": "*",
    "@shopify/flash-list": "*",
    "@stxapps/expo-crypto": "*",
    "@stxapps/expo-react": "*",
    "@stxapps/react": "*",
    "@stxapps/shared": "*",
    "@tanstack/react-query": "*",
    "@testing-library/react-native": "*",
    "@zxcvbn-ts/core": "*",
    "@zxcvbn-ts/language-common": "*",
    "@zxcvbn-ts/language-en": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "expo": "*",
    "expo-build-properties": "*",
    "expo-clipboard": "*",
    "expo-constants": "*",
    "expo-dev-client": "*",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-font": "*",
    "expo-iap": "*",
    "expo-image": "*",
    "expo-image-manipulator": "*",
    "expo-image-picker": "*",
    "expo-linking": "*",
    "expo-local-authentication": "*",
    "expo-router": "*",
    "expo-secure-store": "*",
    "expo-share-extension": "*",
    "expo-sharing": "*",
    "expo-splash-screen": "*",
    "expo-sqlite": "*",
    "expo-status-bar": "*",
    "expo-store-review": "*",
    "expo-system-ui": "*",
    "jest-expo": "*",
    "lucide-react-native": "*",
    "metro-config": "*",
    "metro-resolver": "*",
    "react": "*",
    "react-hook-form": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-keyboard-controller": "*",
    "react-native-nitro-modules": "*",
    "react-native-quick-base64": "*",
    "react-native-quick-crypto": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-web": "*",
    "react-native-worklets": "*",
    "tailwind-merge": "*",
    "tailwindcss": "^4.3.0",
    "uniwind": "*"
  }
}
