# Loaded by Expo when NODE_ENV=production — i.e. a release build (Xcode Release /
# Archive, `./gradlew assembleRelease|bundleRelease`) / `expo export`.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time; nothing secret
# belongs here.
#
# This is the DEFAULT for a release build, and it is never edited to switch
# domains: a staging release build is `npm run android:release:staging` /
# `ios:release:staging`, which outrank this file from the shell (docs/env-files.md,
# "bracemark-expo"). It is also the ONLY pair a release bundle accepts:
# metro.config.js fails one aimed anywhere else unless BRACEMARK_NONPROD_RELEASE=1
# is set in the shell.
EXPO_PUBLIC_API_URL=https://api.bracemark.com
# The marketing site's origin (bracemark-site), for out-of-app pages the mobile
# app links to (Support). NOT the bracemark-web app's origin — those pages live on
# the apex.
EXPO_PUBLIC_SITE_URL=https://bracemark.com

# Staging, for reference only — copy this pair into `.env.local`, never uncomment
# it here. Staging is its OWN registrable domain (docs/hosting.md).
#EXPO_PUBLIC_API_URL=https://api.dryrunbase.com
#EXPO_PUBLIC_SITE_URL=https://dryrunbase.com
