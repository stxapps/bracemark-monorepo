# Loaded by Expo when NODE_ENV=production — i.e. a release build / `expo export`.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time; nothing secret
# belongs here.
EXPO_PUBLIC_API_URL=https://api.bracemark.com
# The marketing site's origin (bracemark-site), for out-of-app pages the mobile
# app links to (Support). NOT the bracemark-web app's origin — those pages live on
# the apex.
EXPO_PUBLIC_SITE_URL=https://bracemark.com
