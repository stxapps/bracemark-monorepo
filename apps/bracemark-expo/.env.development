# Loaded by Expo when NODE_ENV=development — i.e. `expo start` / `nx dev`
# (the default dev server). Points at the local bracemark-api dev server
# (apps/bracemark-api, default PORT 8787). EXPO_PUBLIC_* vars are inlined into the
# JS bundle by Metro at build time, so nothing secret belongs here.
EXPO_PUBLIC_API_URL=http://localhost:8787
# The marketing site's origin (bracemark-site), for out-of-app pages the mobile
# app links to (Support). NOT the bracemark-web app's origin — those pages live on
# the apex. Dev points at the local site dev server, which runs on 3001.
EXPO_PUBLIC_SITE_URL=http://localhost:3001
