# Loaded by `wxt build` (mode=production) — the production store build.
# WXT_PUBLIC_* vars are baked into the bundle, so nothing secret belongs here.
# The ONLY value a production build accepts: wxt.config.ts fails one whose api is
# anything else (an override in a `.env*.local` or the shell) unless
# BRACEMARK_NONPROD_RELEASE=1 is set in the shell (docs/env-files.md).
WXT_PUBLIC_API_URL=https://api.bracemark.com
