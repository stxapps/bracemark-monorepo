{
  "name": "@stxapps/bracemark-extension",
  "version": "1.3.1",
  "private": true,
  "description": "manifest.json description",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:development": "wxt build --mode development",
    "build:staging": "wxt build --mode staging",
    "build:staging:firefox": "wxt build -b firefox --mode staging",
    "build:staging:safari": "wxt build -b safari --mode staging",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "bash ../../tools/scripts/store-release.sh build chrome -- wxt zip",
    "zip:edge": "bash ../../tools/scripts/store-release.sh build edge -- wxt zip",
    "zip:firefox": "bash ../../tools/scripts/store-release.sh build firefox -- wxt zip -b firefox",
    "tag:chrome": "bash ../../tools/scripts/store-release.sh tag chrome",
    "tag:edge": "bash ../../tools/scripts/store-release.sh tag edge",
    "tag:firefox": "bash ../../tools/scripts/store-release.sh tag firefox"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:web"
    ],
    "targets": {
      "build:development": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output/chrome-mv3-dev"
        ]
      },
      "build:staging": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output/chrome-mv3-staging"
        ]
      },
      "build:staging:firefox": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output/firefox-mv3-staging"
        ]
      },
      "build:staging:safari": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output/safari-mv3-staging"
        ]
      },
      "build": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output/chrome-mv3"
        ]
      },
      "build:firefox": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output/firefox-mv3"
        ]
      },
      "build:safari": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output/safari-mv3"
        ]
      },
      "zip": {
        "cache": false
      },
      "zip:edge": {
        "cache": false
      },
      "zip:firefox": {
        "cache": false
      }
    }
  },
  "dependencies": {
    "@stxapps/react": "*",
    "@stxapps/shared": "*",
    "@stxapps/web-crypto": "*",
    "@stxapps/web-react": "*",
    "@stxapps/web-ui": "*",
    "@tanstack/react-query": "^5.101.0",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.0",
    "wxt": "^0.20.26"
  }
}
