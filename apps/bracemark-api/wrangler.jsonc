{
  // Cloudflare Workers config for bracemark-api. The code is wired — `wrangler` is
  // installed, `src/worker.ts` is the entry, and `app.ts` reads `c.env`. What
  // remains is filling the `TODO` values and provisioning the resources. See
  // docs/hosting.md and docs/env-files.md#bracemark-api.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bracemark-api",
  // Workers entry: src/worker.ts default-exports the Hono app; the runtime calls
  // fetch(request, env, ctx) on it.
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  // Add only if a dependency needs Node built-ins (Hono + zod don't):
  // "compatibility_flags": ["nodejs_compat"],
  // Cloudflare's own log — what `wrangler tail` and the dashboard show. The
  // invocation log stays ON here, unlike bracemark-extractor, which turns it off
  // because its request line carries a user-supplied URL; this Worker's paths
  // carry opaque ids and its bodies are ciphertext.
  //
  // ⚠ "Opaque ids" has to stay true of the whole URL, query string included,
  // because an entry in this log holds the request line whole beside the client
  // IP and the location Cloudflare derives from it (read back from both deployed
  // tiers, 2026-10-13: the URL, the request headers with `authorization` masked,
  // the IP, the response status — no body). It was NOT true for a stretch: three
  // pre-auth lookups were GETs carrying `?username=…`, so their entries paired a
  // username with an IP. They are POSTs now, and /privacy's _Technical and
  // security data_ says in as many words that this log is on and that no address
  // in it contains a username. A GET whose query carries anything a person chose
  // falsifies that sentence; `query-inventory.spec.ts` in @stxapps/shared is
  // what notices. docs/api-contracts.md, _a GET's query string reaches the
  // request log_.
  //
  // NEVER add `"logpush": true`. It reads like a sibling of `observability` and
  // is a different CHANNEL: it ships this Worker's TRACE EVENTS — request line,
  // headers, console output — off Cloudflare to a destination you configure, so
  // nothing in this block governs it. That is an off-box copy of the request
  // stream of the component whose whole claim is that it holds no key and sees
  // no plaintext, kept under someone else's retention policy. Nothing catches
  // the key: no lint error, no type error, no test in either runner.
  // bracemark-extractor's wrangler.jsonc has the sharper version of this.
  //
  // `traces` is pinned OFF rather than left unset. Today `enabled: true` turns on
  // logs alone, but only because Cloudflare says so while tracing is in beta — a
  // default that can move on their release, with no change here. A trace is a
  // second stored record of the request, with a span per outbound call, and
  // nothing above was written with it in mind. Turning it on is a decision that
  // /privacy has to hear about first, so it is spelled out as one.
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false,
    },
  },
  // Pin the local `wrangler dev` port. Without this, wrangler treats 8787 as a
  // *default* and silently falls back to a random port (8788, …) when 8787 is
  // already taken — e.g. a leftover/zombie wrangler, or running `npm run dev`
  // while a standalone `nx run bracemark-api:dev` is up. bracemark-web is hardcoded to
  // http://localhost:8787 (see apps/bracemark-web/.env.development), so any drift
  // makes the API "unreachable". Setting `port` explicitly makes wrangler bind
  // 8787 or fail loudly (EADDRINUSE) instead of drifting.
  //
  // `inspector_port` (the V8 debugger socket) ALSO defaults to a fixed value —
  // 9229 — and is NOT covered by `port`, so two `wrangler dev`s collide on it
  // even with distinct HTTP ports. Under `npm run dev` bracemark-api + bracemark-extractor
  // run side by side, so pin a distinct inspector_port per app too (9229/9230,
  // mirroring 8787/8788) to avoid "Address already in use (127.0.0.1:9229)".
  //
  // `ip` defaults to `localhost`, so wrangler binds 127.0.0.1/[::1] ONLY and is
  // unreachable from another device on the LAN — while the Next dev servers bind
  // `0.0.0.0` by default and are reachable, which makes the failure look like a
  // network problem rather than a bind address ("the phone loads :3000 but not
  // :8787"). A physical iOS device cannot be taught that localhost means the host
  // the way `adb reverse` teaches the Android emulator, so the phone has to reach
  // the Mac by LAN IP and this Worker has to be listening on it. Dev-only — it is
  // in the top-level `dev` block, never in a deployed env — but it does mean the
  // local api, with local D1/R2 state, answers anything on the current network.
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787,
    "inspector_port": 9229,
  },
  // --- per-tier environments -------------------------------------------------
  // Bindings (`vars`, `d1_databases`, `r2_buckets`) are NOT inherited from the
  // top level — each environment must declare its own. Worker names auto-suffix
  // to `bracemark-api-staging` / `bracemark-api-production`.
  //
  // NO `account_id` HERE, deliberately. Each tier IS a separate Cloudflare
  // account, but this file is public and an account id is inventory — it names
  // what exists and where. The deploy target comes from the environment instead,
  // alongside that tier's own API token:
  //   CLOUDFLARE_ACCOUNT_ID=<staging id>    wrangler deploy --env staging
  //   CLOUDFLARE_ACCOUNT_ID=<production id> wrangler deploy --env production
  // On a dev machine that value lives in the gitignored `.env.<tier>.local`
  // beside this file: wrangler loads `.env.<env>.local` for that `--env` and no
  // other, which is the only thing that tier-scopes a variable whose NAME has no
  // tier in it. An exported value still wins over the file. Not the committed
  // `.env.<tier>` — wrangler reads those too and they are public, same problem as
  // this file. See docs/env-files.md, _bracemark-api_.
  // That gives up a guard, so the remaining one has to hold: mint every token
  // against _Specific account_, never _All accounts_. One user owns both
  // accounts, so an all-accounts token plus the wrong CLOUDFLARE_ACCOUNT_ID
  // deploys to the wrong tier without complaining — where the pinned
  // `account_id` used to make that a config mismatch instead.
  //
  // Secrets are NOT stored here — set them per env:
  //   wrangler secret put <NAME> --env staging|production
  // Non-secret config (e.g. CORS_ORIGINS) lives in `vars` below — including the
  // local-only `development` env that `wrangler dev` uses, so it's committed and
  // shared. Local *secrets* come from the login keychain via
  // tools/scripts/run-api-dev.sh — never a `.dev.vars`, which that script refuses to
  // start beside (see the `development` env's `secrets` below).
  "env": {
    // Local-only — used by `wrangler dev --env development`, never deployed.
    // D1/R2 are emulated by miniflare (state under .wrangler/). The
    // ids here are placeholders (no real Cloudflare DB is hit locally) BUT they
    // must be DISTINCT: miniflare keys each local D1 store by `database_id`, so
    // reusing one id (e.g. "local") collapses all three roles into a single
    // physical SQLite db. That bites both `wrangler dev` and the Workers test
    // pool — e.g. `applyD1Migrations` dedupes by migration name in a shared
    // `d1_migrations` table, so identically-named migrations across roles get
    // skipped. Keep one id per role.
    "development": {
      "vars": {
        // Both Next dev servers: bracemark-web on 3000, bracemark-site on 3001.
        // The two deployed tiers below list the same pair as `app.*` + apex.
        "CORS_ORIGINS": "http://localhost:3000,http://localhost:3001",
        // R2 S3-API credentials for presigning (lib/r2-presign.ts). LOCAL-ONLY
        // placeholders — `wrangler dev` and the Workers test pool emulate R2 with
        // miniflare, so these never authenticate against real R2; the presigned
        // URLs they produce are only ever shape-checked locally, never fetched.
        // In staging/prod the account id and the key pair are SECRETS, not vars
        // (see those envs).
        "R2_ACCOUNT_ID": "local-account-id",
        "R2_ACCESS_KEY_ID": "local-access-key-id",
        "R2_SECRET_ACCESS_KEY": "local-secret-access-key",
        "R2_USER_FILES_BUCKET": "bracemark-user-files-dev",
        // The Server-Timing breakdown (src/lib/server-timing.ts) — on here and in
        // staging, where sync is measured; production leaves it unset.
        "SERVER_TIMING": "1",
        // Paddle Billing (routes/iap.ts). Local dev talks to the SANDBOX; the
        // price ids are the sandbox catalog's pri_… ids (Plus exists; Pro is a
        // placeholder until its sandbox product does). The webhook secret + API
        // key are SECRETS — see `secrets` below.
        "PADDLE_API_BASE": "https://sandbox-api.paddle.com",
        // COMMA-SEPARATED lists: every price a plan may be billed at, the one
        // on sale FIRST. The read side accepts them all (an unrecognized price
        // is a permanent drop — the subscriber pays and is never entitled), the
        // checkout sells the first. Add, never replace.
        "PADDLE_PRICE_ID_PLUS": "pri_01m2sbmvgv19d85spx9wbqgab8",
        // Pro is not on sale (AVAILABLE_PAID_PLANS, @stxapps/shared iap/plans.ts),
        // so it has no price: EMPTY, not a `TODO:` — deploy-worker.sh refuses a
        // production deploy while any TODO remains, and an off-sale plan is not
        // unfinished config. Fill it in the same change that puts Pro on sale;
        // `npm run check:paddle` fails an on-sale plan whose list is empty.
        "PADDLE_PRICE_ID_PRO": "",
        // Store IAP (routes/iap.ts verify + notify; lib/appstore.ts,
        // lib/playstore.ts). Local dev talks to the App Store SANDBOX host. The
        // private keys + the Play push token are SECRETS — see `secrets` below.
        // Store product ids are NOT env config — they're shared constants
        // (@stxapps/shared iap/store-products.ts), identical across envs.
        "APPSTORE_API_BASE": "https://api.storekit-sandbox.itunes.apple.com",
        "APPSTORE_ISSUER_ID": "af0c83b8-7f81-4b5b-80b5-a900632f98db",
        "APPSTORE_KEY_ID": "32Q498XJQF",
        "APPSTORE_BUNDLE_ID": "com.bracemark.app",
        "PLAY_PACKAGE_NAME": "com.bracemark.app",
        "PLAY_SA_EMAIL": "bracemark-api@pc-api-5432578715760309051-262.iam.gserviceaccount.com",
      },
      // The local secrets, and the switch that makes `wrangler dev` read them
      // from the shell: with this list declared and no `.dev.vars*` file, it
      // binds exactly these names from process.env and nothing else.
      // tools/scripts/run-api-dev.sh fills them from the login keychain — keep its
      // SECRETS list identical to this one. `development` ONLY: in a deployed
      // env the same key makes `wrangler deploy` demand every name, including
      // the ones whose store setup is still TODO. See docs/env-files.md,
      // _bracemark-api local secrets_.
      "secrets": {
        "required": [
          "PADDLE_WEBHOOK_SECRET",
          "PADDLE_API_KEY",
          "APPSTORE_PRIVATE_KEY",
          "PLAY_SA_PRIVATE_KEY",
          "PLAY_NOTIFY_TOKEN",
        ],
      },
      // DIRECTORY_DB: global username directory (usernames). ACCOUNTS_DB_1: first
      // account shard (users, account_keys). SESSIONS_DB: bearer-token sessions
      // (separate, high-churn, non-Tier-0). Bindings are STATIC. migrations_dir is
      // per-binding — each role has its own history
      // (src/db/migrations/{directory,accounts,sessions}); durable objects migrate
      // in code. See src/db/migrations/README.md.
      "d1_databases": [
        {
          "binding": "DIRECTORY_DB",
          "database_name": "bracemark-directory-db-dev",
          "database_id": "directory-db-local",
          "migrations_dir": "src/db/migrations/directory",
        },
        {
          "binding": "ACCOUNTS_DB_1",
          "database_name": "bracemark-accounts-db-1-dev",
          "database_id": "accounts-db-1-local",
          "migrations_dir": "src/db/migrations/accounts",
        },
        {
          "binding": "SESSIONS_DB",
          "database_name": "bracemark-sessions-db-dev",
          "database_id": "sessions-db-local",
          "migrations_dir": "src/db/migrations/sessions",
        },
      ],
      "r2_buckets": [
        {
          "binding": "USER_FILES",
          "bucket_name": "bracemark-user-files-dev",
        },
      ],
      // Per-user SQLite store. One DO instance per user (addressed by
      // idFromName(userId)); the `migrations` tag below makes the class
      // SQLite-backed (ctx.storage.sql). DO *schema* migrations are NOT here —
      // they run in code (src/do/user-data.ts). Locally these run in miniflare
      // (state under .wrangler/).
      "durable_objects": {
        "bindings": [{ "name": "USER_DATA", "class_name": "UserDataDO" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDataDO"] }],
      // The daily cron → worker.ts `scheduled` (session cleanup, docs/sessions.md).
      // `wrangler dev` never fires it on its own; trigger it by hand with
      // `curl "http://127.0.0.1:8787/cdn-cgi/handler/scheduled"`. Declared per
      // env, like everything else here, so no env silently runs without it.
      "triggers": { "crons": ["17 3 * * *"] },
      // Native rate-limit bindings, one per volume tier (middleware/rate-limit.ts).
      // period is 10 or 60 only; 'tight' (10/10s ≈ 1 req/s) is the strictest the
      // native binding allows. namespace_id is any unique positive integer.
      //
      // ⚠ 'standard' is DELIBERATELY ~100× the deployed tiers' 60/60s here, and
      // must stay far above them. The binding buckets by IP+path, and locally
      // every client is one IP — both Playwright workers and each of their tabs,
      // the browser extension, both simulators — so a bucket the deployed tiers
      // size for one user is shared by the whole machine. `/v1/iap/status` takes
      // no query string, so they all collide on one key. At 60/60s a full e2e
      // run 429s, and the client half honours the 60s Retry-After (shared
      // api/retry.ts): each hit parks that call for 60–75s. Neither symptom
      // names a rate limit — the entitlement read stays FREE and a Plus-gated
      // control silently opens its upsell, and delete-all sits on its spinner
      // past any plausible test timeout (docs/e2e.md, _the local rate limit_).
      // The binding stays wired rather than dropped so the middleware path and
      // the env's shape still match the deployed tiers; the 429 envelope and the
      // backoff are proved at unit level (app.spec.ts, middleware/
      // rate-limit.spec.ts, shared api/retry.spec.ts), not here.
      "ratelimits": [
        {
          "name": "API_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 6000, "period": 60 },
        },
        {
          "name": "API_RATE_LIMIT_TIGHT",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 10 },
        },
        {
          // WIDE tier — sole limiter for the Paddle webhook, which is exempt from
          // the 'standard' baseline (all of Paddle's deliveries share one IP+path
          // bucket). See middleware/rate-limit.ts (`webhook` tier).
          "name": "API_RATE_LIMIT_WEBHOOK",
          "namespace_id": "1003",
          "simple": { "limit": 100, "period": 10 },
        },
        {
          // PER-USER tier — sole limiter for the blob route, which is exempt from
          // the 'standard' baseline (one path for every object). See
          // middleware/rate-limit.ts (`blob` tier). ⚠ 10× the deployed tiers'
          // here, for the reason 'standard' is far above them, in another shape:
          // on loopback a read takes milliseconds, and measure:sync's floor leg
          // reads ~1,000 a second — the deployed limit — from one account.
          "name": "API_RATE_LIMIT_BLOB",
          "namespace_id": "1004",
          "simple": { "limit": 100000, "period": 10 },
        },
      ],
    },
    "staging": {
      "vars": {
        // Comma-separated exact origins (corsOrigins() splits on ','). No
        // wildcards — the matcher compares literally, so list each subdomain.
        // Web origins ONLY. Extensions and the future mobile app authenticate
        // with a bearer token (Authorization header), not cookies, and are NOT
        // browser-CORS-bound: MV3 extensions exempt background fetches to their
        // host_permissions origin (see bracemark-extension/wxt.config.ts), and
        // native apps have no CORS. So do NOT add chrome-extension://,
        // moz-extension://, or safari-web-extension:// origins here.
        // Staging lives on its OWN registrable domain (dryrunbase.com), not a
        // subdomain of bracemark.com — docs/hosting.md, _why staging is a
        // separate domain_. Apex = bracemark-site, app. = bracemark-web.
        "CORS_ORIGINS": "https://dryrunbase.com,https://app.dryrunbase.com",
        // R2 presigning config (r2/presign.ts). Only the bucket is a var here.
        // R2_ACCOUNT_ID is the same Cloudflare account id that
        // CLOUDFLARE_ACCOUNT_ID carries at deploy time, so it is kept out of this
        // public file the same way — set as a SECRET even though it is not one.
        // The key PAIR genuinely are secrets:
        //   wrangler secret put R2_ACCOUNT_ID --env staging
        //   wrangler secret put R2_ACCESS_KEY_ID --env staging
        //   wrangler secret put R2_SECRET_ACCESS_KEY --env staging
        // Mint the keys in the R2 dashboard (Manage R2 API Tokens) scoped to the
        // bucket below. See docs/hosting.md.
        "R2_USER_FILES_BUCKET": "bracemark-user-files-staging",
        // The Server-Timing breakdown (src/lib/server-timing.ts) — on here, where
        // `measure:sync` runs; production leaves it unset.
        "SERVER_TIMING": "1",
        // Paddle Billing — staging uses the Paddle SANDBOX (separate account,
        // separate pri_… catalog from live). Secrets, set separately:
        //   wrangler secret put PADDLE_WEBHOOK_SECRET --env staging
        //   wrangler secret put PADDLE_API_KEY --env staging
        // Register the webhook in the sandbox dashboard pointing at
        // https://api.dryrunbase.com/v1/iap/paddle/webhook.
        "PADDLE_API_BASE": "https://sandbox-api.paddle.com",
        // COMMA-SEPARATED lists: every price a plan may be billed at, the one
        // on sale FIRST. The read side accepts them all (an unrecognized price
        // is a permanent drop — the subscriber pays and is never entitled), the
        // checkout sells the first. Add, never replace.
        "PADDLE_PRICE_ID_PLUS": "pri_01m2sbmvgv19d85spx9wbqgab8",
        // Empty while Pro is off sale — see the development env.
        "PADDLE_PRICE_ID_PRO": "",
        // Store IAP — staging verifies against the App Store SANDBOX. Secrets,
        // set separately:
        //   wrangler secret put APPSTORE_PRIVATE_KEY --env staging
        //   wrangler secret put PLAY_SA_PRIVATE_KEY --env staging
        //   wrangler secret put PLAY_NOTIFY_TOKEN --env staging
        // Register the webhooks per env: App Store Connect → App Store Server
        // Notifications V2 (sandbox URL) → https://api.dryrunbase.com/v1/iap/appstore/notify;
        // Play Console RTDN Pub/Sub push →
        // https://api.dryrunbase.com/v1/iap/playstore/notify?token=<PLAY_NOTIFY_TOKEN>.
        "APPSTORE_API_BASE": "https://api.storekit-sandbox.itunes.apple.com",
        "APPSTORE_ISSUER_ID": "af0c83b8-7f81-4b5b-80b5-a900632f98db",
        "APPSTORE_KEY_ID": "32Q498XJQF",
        "APPSTORE_BUNDLE_ID": "com.bracemark.app",
        "PLAY_PACKAGE_NAME": "com.bracemark.app",
        "PLAY_SA_EMAIL": "bracemark-api@pc-api-5432578715760309051-262.iam.gserviceaccount.com",
      },
      "d1_databases": [
        {
          "binding": "DIRECTORY_DB",
          "database_name": "bracemark-directory-db-staging",
          "database_id": "33afb367-6556-4f00-9cac-6254c19ab7f4",
          "migrations_dir": "src/db/migrations/directory",
        },
        {
          "binding": "ACCOUNTS_DB_1",
          "database_name": "bracemark-accounts-db-1-staging",
          "database_id": "d1dfe23f-9a64-445f-b7d7-3584b0dafa73",
          "migrations_dir": "src/db/migrations/accounts",
        },
        {
          "binding": "SESSIONS_DB",
          "database_name": "bracemark-sessions-db-staging",
          "database_id": "07ffd86d-3e51-4679-959e-9025314d514d",
          "migrations_dir": "src/db/migrations/sessions",
        },
      ],
      "r2_buckets": [
        {
          "binding": "USER_FILES",
          "bucket_name": "bracemark-user-files-staging",
        },
      ],
      // Per-user SQLite store (see development env for notes). DO *schema*
      // migrations run in code (src/do/user-data.ts), not here; the `migrations`
      // tag only declares the class as SQLite-backed.
      "durable_objects": {
        "bindings": [{ "name": "USER_DATA", "class_name": "UserDataDO" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDataDO"] }],
      // The daily cron → worker.ts `scheduled`: session cleanup on its two
      // retention clocks (docs/sessions.md). Daily is plenty — the retention is
      // a year. Deploying it is a config change; read docs/hosting.md first.
      "triggers": { "crons": ["17 3 * * *"] },
      // Not inherited from the top level — each env declares its own.
      "ratelimits": [
        {
          "name": "API_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "API_RATE_LIMIT_TIGHT",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 10 },
        },
        {
          // WIDE tier — sole limiter for the Paddle webhook, which is exempt from
          // the 'standard' baseline (all of Paddle's deliveries share one IP+path
          // bucket). See middleware/rate-limit.ts (`webhook` tier).
          "name": "API_RATE_LIMIT_WEBHOOK",
          "namespace_id": "1003",
          "simple": { "limit": 100, "period": 10 },
        },
        {
          // PER-USER tier — sole limiter for the blob route, which is exempt from
          // the 'standard' baseline (one path for every object). See
          // middleware/rate-limit.ts (`blob` tier).
          "name": "API_RATE_LIMIT_BLOB",
          "namespace_id": "1004",
          "simple": { "limit": 10000, "period": 10 },
        },
      ],
      "routes": [{ "pattern": "api.dryrunbase.com", "custom_domain": true }],
    },
    "production": {
      "vars": {
        // Comma-separated exact origins (corsOrigins() splits on ','). No
        // wildcards — the matcher compares literally, so list each subdomain.
        // Web origins ONLY. Extensions and the future mobile app authenticate
        // with a bearer token (Authorization header), not cookies, and are NOT
        // browser-CORS-bound: MV3 extensions exempt background fetches to their
        // host_permissions origin (see bracemark-extension/wxt.config.ts), and
        // native apps have no CORS. So do NOT add chrome-extension://,
        // moz-extension://, or safari-web-extension:// origins here.
        "CORS_ORIGINS": "https://bracemark.com,https://app.bracemark.com",
        // R2 presigning config (r2/presign.ts). Only the bucket is a var here.
        // R2_ACCOUNT_ID is the same Cloudflare account id that
        // CLOUDFLARE_ACCOUNT_ID carries at deploy time, so it is kept out of this
        // public file the same way — set as a SECRET even though it is not one.
        // The key PAIR genuinely are secrets:
        //   wrangler secret put R2_ACCOUNT_ID --env production
        //   wrangler secret put R2_ACCESS_KEY_ID --env production
        //   wrangler secret put R2_SECRET_ACCESS_KEY --env production
        // Mint the keys in the R2 dashboard (Manage R2 API Tokens) scoped to the
        // bucket below. See docs/hosting.md.
        "R2_USER_FILES_BUCKET": "bracemark-user-files-production",
        // Paddle Billing — LIVE Paddle. Secrets, set separately:
        //   wrangler secret put PADDLE_WEBHOOK_SECRET --env production
        //   wrangler secret put PADDLE_API_KEY --env production
        // Register the webhook in the live dashboard pointing at
        // https://api.bracemark.com/v1/iap/paddle/webhook.
        "PADDLE_API_BASE": "https://api.paddle.com",
        // COMMA-SEPARATED lists, on sale FIRST — see the development env.
        "PADDLE_PRICE_ID_PLUS": "pri_01m2snpfpfe3e254kcehqjcf42",
        // Empty while Pro is off sale — see the development env.
        "PADDLE_PRICE_ID_PRO": "",
        // Store IAP — production verifies against the PRODUCTION App Store host
        // (with the code-level sandbox fallback on 404 for App Review — see
        // lib/appstore.ts). Secrets, set separately:
        //   wrangler secret put APPSTORE_PRIVATE_KEY --env production
        //   wrangler secret put PLAY_SA_PRIVATE_KEY --env production
        //   wrangler secret put PLAY_NOTIFY_TOKEN --env production
        // Register the webhooks: App Store Connect → App Store Server
        // Notifications V2 (production URL) → https://api.bracemark.com/v1/iap/appstore/notify;
        // Play Console RTDN Pub/Sub push →
        // https://api.bracemark.com/v1/iap/playstore/notify?token=<PLAY_NOTIFY_TOKEN>.
        "APPSTORE_API_BASE": "https://api.storekit.itunes.apple.com",
        "APPSTORE_ISSUER_ID": "af0c83b8-7f81-4b5b-80b5-a900632f98db",
        "APPSTORE_KEY_ID": "32Q498XJQF",
        "APPSTORE_BUNDLE_ID": "com.bracemark.app",
        "PLAY_PACKAGE_NAME": "com.bracemark.app",
        "PLAY_SA_EMAIL": "bracemark-api@pc-api-5432578715760309051-262.iam.gserviceaccount.com",
      },
      "d1_databases": [
        {
          "binding": "DIRECTORY_DB",
          "database_name": "bracemark-directory-db-production",
          "database_id": "4d8c5967-be48-4b54-991c-0cf5f830943d",
          "migrations_dir": "src/db/migrations/directory",
        },
        {
          "binding": "ACCOUNTS_DB_1",
          "database_name": "bracemark-accounts-db-1-production",
          "database_id": "9b319b3c-0d44-4c81-8a16-83d14a5f35a7",
          "migrations_dir": "src/db/migrations/accounts",
        },
        {
          "binding": "SESSIONS_DB",
          "database_name": "bracemark-sessions-db-production",
          "database_id": "57e69d99-2226-4f4d-86ed-f512ecfa90bb",
          "migrations_dir": "src/db/migrations/sessions",
        },
      ],
      "r2_buckets": [
        {
          "binding": "USER_FILES",
          "bucket_name": "bracemark-user-files-production",
        },
      ],
      // Per-user SQLite store (see development env for notes). DO *schema*
      // migrations run in code (src/do/user-data.ts), not here; the `migrations`
      // tag only declares the class as SQLite-backed.
      "durable_objects": {
        "bindings": [{ "name": "USER_DATA", "class_name": "UserDataDO" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDataDO"] }],
      // The daily cron → worker.ts `scheduled`: session cleanup on its two
      // retention clocks (docs/sessions.md). Daily is plenty — the retention is
      // a year. Deploying it is a config change; read docs/hosting.md first.
      "triggers": { "crons": ["17 3 * * *"] },
      // Not inherited from the top level — each env declares its own.
      "ratelimits": [
        {
          "name": "API_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "API_RATE_LIMIT_TIGHT",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 10 },
        },
        {
          // WIDE tier — sole limiter for the Paddle webhook, which is exempt from
          // the 'standard' baseline (all of Paddle's deliveries share one IP+path
          // bucket). See middleware/rate-limit.ts (`webhook` tier).
          "name": "API_RATE_LIMIT_WEBHOOK",
          "namespace_id": "1003",
          "simple": { "limit": 100, "period": 10 },
        },
        {
          // PER-USER tier — sole limiter for the blob route, which is exempt from
          // the 'standard' baseline (one path for every object). See
          // middleware/rate-limit.ts (`blob` tier).
          "name": "API_RATE_LIMIT_BLOB",
          "namespace_id": "1004",
          "simple": { "limit": 10000, "period": 10 },
        },
      ],
      "routes": [{ "pattern": "api.bracemark.com", "custom_domain": true }],
    },
  },
}
