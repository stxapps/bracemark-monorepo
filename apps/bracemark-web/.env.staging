# Loaded by `nx build bracemark-web --configuration=staging` via the target's
# `envFile` option (Nx loads it into process.env, overriding Next's auto-loaded
# .env.production). All vars are NEXT_PUBLIC_* and baked into the static bundle —
# nothing secret belongs here.
NEXT_PUBLIC_API_URL=https://api.dryrunbase.com
NEXT_PUBLIC_EXTRACTOR_URL=https://extractor.dryrunbase.com

# This app's own origin, baked into the OG/Twitter card metadata in
# `src/app/layout.tsx` — card images must be absolute, and they live in this app's
# `public/`. Per-tier like everything else here, so a staging bundle never
# advertises production's URLs; the deploy script's tier check enforces that.
NEXT_PUBLIC_APP_URL=https://app.dryrunbase.com

# The marketing site's origin (bracemark-site), for the pages that live there and
# not here: support, terms, privacy. The apex, not an `app.` host.
#
# Staging is its OWN registrable domain (dryrunbase.com), not a subdomain of
# bracemark.com — a Workers custom domain needs its zone in the staging
# Cloudflare account, and a subdomain can't be an independent zone off
# Enterprise. See docs/hosting.md — _why staging is a separate domain_.
NEXT_PUBLIC_SITE_URL=https://dryrunbase.com

# Paddle Billing (src/lib/paddle.ts) — staging pairs with the Paddle SANDBOX.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_9dea978cc84b149ae9200c666c3

# Whether app/robots.ts emits `Allow: /` or `Disallow: /`. No NEXT_PUBLIC_
# prefix on purpose: it is read at build time only and never belongs in a
# client chunk. Required — robots.ts throws on anything but true/false.
# THE POINT OF THIS VAR. dryrunbase.com is a real public domain, so without
# this the whole tier gets crawled and indexed alongside production.
ALLOW_INDEXING=false
