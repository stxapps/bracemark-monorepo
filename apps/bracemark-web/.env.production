# Loaded automatically by `next build` (NODE_ENV=production) — the production deploy.
# All vars here are NEXT_PUBLIC_* and get baked into the static bundle, so nothing
# secret belongs in this file.
NEXT_PUBLIC_API_URL=https://api.bracemark.com
NEXT_PUBLIC_EXTRACTOR_URL=https://extractor.bracemark.com

# This app's own origin, baked into the OG/Twitter card metadata in
# `src/app/layout.tsx` — card images must be absolute, and they live in this app's
# `public/`. Per-tier like everything else here; the deploy script's tier check
# refuses a bundle carrying the other tier's origins.
NEXT_PUBLIC_APP_URL=https://app.bracemark.com

# The marketing site's origin (bracemark-site), for the pages that live there and
# not here: support, terms, privacy. The apex, not an `app.` host.
NEXT_PUBLIC_SITE_URL=https://bracemark.com

# Paddle Billing (src/lib/paddle.ts) — LIVE Paddle; client tokens are public by design.
NEXT_PUBLIC_PADDLE_ENV=production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=TODO-live-client-token

# Whether app/robots.ts emits `Allow: /` or `Disallow: /`. No NEXT_PUBLIC_
# prefix on purpose: it is read at build time only and never belongs in a
# client chunk. Required — robots.ts throws on anything but true/false.
# The only place this is `true`.
ALLOW_INDEXING=true
