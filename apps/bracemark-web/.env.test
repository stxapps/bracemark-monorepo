# Loaded automatically by `next/jest` (NODE_ENV=test) — the jest run, nothing else.
#
# It exists so module-scope env reads don't have to defend themselves. Next only
# auto-loads `.env.<mode>` for the CURRENT mode, and jest runs as `test`, so
# .env.development/.staging/.production are all invisible here — every
# NEXT_PUBLIC_* would otherwise be undefined and `lib/api-client.ts`,
# `lib/site.ts` and `app/layout.tsx` would each take the suite down at import
# time, before a single test ran. See docs/env-files.md, _the test env_.
#
# Values are the development ones: nothing here reaches the network (the api,
# the extractor and Paddle are all mocked at the fetch/hook boundary), they just
# have to exist and parse.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_EXTRACTOR_URL=http://localhost:8788
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_9dea978cc84b149ae9200c666c3

# Whether app/robots.ts emits `Allow: /` or `Disallow: /`. No NEXT_PUBLIC_
# prefix on purpose: it is read at build time only and never belongs in a
# client chunk. Required — robots.ts throws on anything but true/false.
# Never rendered under jest — present only so the four files stay symmetrical
# and `app/robots.ts` never has to guess.
ALLOW_INDEXING=false
