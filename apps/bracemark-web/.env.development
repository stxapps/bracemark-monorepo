# Loaded automatically by `next dev` (NODE_ENV=development) — local development.
# Points at the local bracemark-api dev server (apps/bracemark-api, default PORT 8787).
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_EXTRACTOR_URL=http://localhost:8788

# This app's own origin, baked into the OG/Twitter card metadata in
# `src/app/layout.tsx` — card images must be absolute, and they live in this app's
# `public/`. Same var name bracemark-site uses for this same host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The marketing site's origin (bracemark-site), for the pages that live there and
# not here: support, terms, privacy. Dev points at the local site dev server,
# which runs on 3001 so it can sit beside this app on 3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Paddle Billing (src/lib/paddle.ts). Sandbox for local dev; the client-side
# token is public by design (pair it with the sandbox catalog in bracemark-api's
# wrangler.jsonc development env).
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_9dea978cc84b149ae9200c666c3

# Whether app/robots.ts emits `Allow: /` or `Disallow: /`. No NEXT_PUBLIC_
# prefix on purpose: it is read at build time only and never belongs in a
# client chunk. Required — robots.ts throws on anything but true/false.
# Local dev is not reachable by a crawler; `false` keeps the four files
# symmetrical and makes production the only place indexing is switched on.
ALLOW_INDEXING=false
