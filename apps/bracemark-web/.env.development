# Loaded automatically by `next dev` (NODE_ENV=development) — local development.
# Points at the local bracemark-api dev server (apps/bracemark-api, default PORT 8787).
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_EXTRACTOR_URL=http://localhost:8788

# The marketing site's origin (bracemark-site), for the pages that live there and
# not here: support, terms, privacy. Dev points at the local site dev server,
# which runs on 3001 so it can sit beside this app on 3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Paddle Billing (src/lib/paddle.ts). Sandbox for local dev; the client-side
# token is public by design (pair it with the sandbox catalog in bracemark-api's
# wrangler.jsonc development env).
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=TODO-sandbox-client-token
