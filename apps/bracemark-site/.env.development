# Loaded automatically by `next dev` (NODE_ENV=development) — local development.
# Points at the local bracemark-api dev server (apps/bracemark-api, default PORT 8787)
# and at bracemark-web on its own dev port.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Where the "Sign in" / "Get Started" links go. The marketing site never renders the
# app itself — it hands off to bracemark-web at the `app.` host (docs/hosting.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Whether app/robots.ts emits `Allow: /` or `Disallow: /`. No NEXT_PUBLIC_
# prefix on purpose: it is read at build time only and never belongs in a
# client chunk. Required — robots.ts throws on anything but true/false.
# Local dev is not reachable by a crawler; `false` keeps the four files
# symmetrical and makes production the only place indexing is switched on.
ALLOW_INDEXING=false
