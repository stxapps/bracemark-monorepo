# Loaded automatically by `next/jest` (NODE_ENV=test) — the jest run, nothing else.
#
# It exists so module-scope env reads don't have to defend themselves. Next only
# auto-loads `.env.<mode>` for the CURRENT mode, and jest runs as `test`, so
# .env.development/.staging/.production are all invisible here — every
# NEXT_PUBLIC_* would otherwise be undefined and any module that throws on a
# missing one would take the suite down at import time, before a single test ran.
# See docs/env-files.md, _the test env_.
#
# Values are the development ones: nothing here reaches the network (the api is
# mocked at the fetch/hook boundary), they just have to exist and parse.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Whether app/robots.ts emits `Allow: /` or `Disallow: /`. No NEXT_PUBLIC_
# prefix on purpose: it is read at build time only and never belongs in a
# client chunk. Required — robots.ts throws on anything but true/false.
# Never rendered under jest — present only so the four files stay symmetrical
# and `app/robots.ts` never has to guess.
ALLOW_INDEXING=false
