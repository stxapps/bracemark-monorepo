# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Watchman's transient probe files (see .watchmanconfig) — they appear mid-crawl
# and vanish, so they only ever show up in `git status` at the wrong moment.
.watchman-cookie-*

# The content that must not ship with this AGPL-licensed public repo.
#
# The anchor matters — `/internal/` is this directory only, so a future
# `packages/*/internal/` is unaffected. Deleting this line leaks private content
# into a public repo, which is unrecoverable once pushed (forks, caches, mirrors),
# so `tools/git-hooks/pre-commit` fails the commit independently of it. Do not
# remove one without the other.
/internal/

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
.nx/migrate-runs

# Next.js
.next
out
test-output
next-env.d.ts

# e2e run output (docs/e2e.md): Playwright traces and HTML reports, Maestro
# screenshots, the run manifests, and the per-worker Chrome profiles the app
# fixture creates — a profile holds a live session for a throwaway account and
# must never be committed.
/e2e/.artifacts/

# Seeded dev accounts (docs/e2e.md, "seeding a dev account"): the usernames and
# passwords `npm run seed` created, and the plan it granted each one. Local
# throwaways against local wrangler state — but they are working credentials in
# plain text, so they get their own anchored line rather than riding on
# .artifacts, which a `--reset` or a stray `rm -rf` is expected to clear.
/e2e/credentials/

# Local env overrides (committed env files: .env.development, .env.test,
# .env.staging, .env.production — see docs/env-files.md)
.env*.local

# Cloudflare Workers local vars/secrets (bracemark-api)
.dev.vars
.dev.vars.*

# Cloudflare Workers local state (D1/R2 emulation, wrangler dev)
.wrangler

# Expo
node_modules/
.expo/
# Generated by `expo prebuild` (CNG) — regenerated from app.config.ts, never
# hand-edited, and wiped by `--clean`. Anchored so the COMMITTED native sources
# (packages/expo-crypto/{ios,android}, apps/bracemark-expo/modules/*/{ios,android})
# stay tracked.
/apps/bracemark-expo/ios/
/apps/bracemark-expo/android/
# Gradle output for the COMMITTED native module sources. Unlike
# apps/bracemark-expo/android above, these parent directories ARE tracked (they hold
# hand-written Kotlin), so their build/ and .cxx/ dirs have to be named
# explicitly — a `./gradlew bundleRelease` fills them in place.
/apps/bracemark-expo/modules/*/android/build/
/apps/bracemark-expo/modules/*/android/.cxx/
/packages/*/android/build/
/packages/*/android/.cxx/
# Same reasoning one platform over: `swift test` (packages/expo-crypto/Package.swift,
# which builds ios/BlobFrame.swift for the host so its suite needs no simulator)
# drops its output beside the committed Swift sources.
/packages/*/.build/
.yarn/
dist/
npm-debug.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
cache/
.gradle/
