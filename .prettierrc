{
  "singleQuote": true,
  "printWidth": 100,
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["apps/bracemark-web/**", "apps/bracemark-extension/**", "packages/web-ui/**"],
      "options": {
        "tailwindStylesheet": "packages/web-ui/src/styles.css"
      }
    },
    {
      "files": ["apps/bracemark-expo/**", "packages/expo-react/**"],
      "options": {
        "tailwindStylesheet": "tools/prettier/expo-tailwind.css"
      }
    },
    {
      "files": ["apps/bracemark-site/**"],
      "options": {
        "tailwindStylesheet": "apps/bracemark-site/src/app/globals.css"
      }
    }
  ]
}
