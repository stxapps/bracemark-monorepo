{
  "enabledPlugins": { "nx@nx-claude-plugins": true },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git log:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Read(apps/bracemark-expo/credentials/**)",
      "Read(apps/bracemark-expo/.env.local)",
      "Read(apps/bracemark-expo/android/gradle.properties)"
    ]
  }
}
