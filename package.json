{
  "name": "@stxapps/bracemark-monorepo",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "node tools/scripts/fix-jest-bin.mjs",
    "prepare": "git config core.hooksPath tools/git-hooks || true",
    "check:private": "node tools/scripts/check-private.mjs",
    "reset": "nx reset",
    "lint": "nx run-many -t lint --output-style=stream",
    "lint:fix": "nx run-many -t lint --output-style=stream -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "typecheck": "nx run-many -t typecheck --output-style=stream",
    "test": "nx run-many -t test --output-style=stream",
    "test:cloudfront": "node --test tools/cloudfront/rewrite-url.test.mjs",
    "dev": "nx run-many -t dev -p @stxapps/bracemark-api @stxapps/bracemark-web @stxapps/bracemark-extractor --output-style=stream",
    "dev:ext": "nx dev @stxapps/bracemark-extension",
    "dev:site": "nx dev @stxapps/bracemark-site",
    "expo:android": "nx android @stxapps/bracemark-expo",
    "expo:android:reverse": "nx android:reverse @stxapps/bracemark-expo",
    "expo:android:open": "nx android:open @stxapps/bracemark-expo",
    "expo:ios": "nx ios @stxapps/bracemark-expo",
    "expo:ios:open": "nx ios:open @stxapps/bracemark-expo",
    "e2e:web": "nx e2e-web @stxapps/e2e",
    "e2e:mobile": "nx e2e-mobile @stxapps/e2e",
    "e2e:contract": "nx e2e-contract @stxapps/e2e",
    "seed": "nx seed @stxapps/e2e",
    "seed:fixtures": "nx seed:fixtures @stxapps/e2e",
    "build": "nx run-many -t build --output-style=stream",
    "deploy:web:staging": "bash tools/scripts/deploy-static.sh web staging",
    "deploy:web:production": "bash tools/scripts/deploy-static.sh web production",
    "deploy:site:staging": "bash tools/scripts/deploy-static.sh site staging",
    "deploy:site:production": "bash tools/scripts/deploy-static.sh site production",
    "deploy:api:staging": "bash tools/scripts/deploy-worker.sh api staging",
    "deploy:api:production": "bash tools/scripts/deploy-worker.sh api production",
    "deploy:extractor:staging": "bash tools/scripts/deploy-worker.sh extractor staging",
    "deploy:extractor:production": "bash tools/scripts/deploy-worker.sh extractor production",
    "d1:migrate": "nx run @stxapps/bracemark-api:d1-migrate",
    "d1:migrate:staging": "nx run @stxapps/bracemark-api:d1-migrate --configuration=staging",
    "d1:migrate:production": "nx run @stxapps/bracemark-api:d1-migrate --configuration=production"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@expo/cli": "~54.0.16",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/esbuild": "23.1.1",
