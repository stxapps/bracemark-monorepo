{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "web/**/*.ts",
    "extension/**/*.ts",
    "runner/**/*.ts",
    "seed/**/*.ts",
    "shot/**/*.ts",
    "measure/**/*.ts",
    "pwa/**/*.ts",
    "visual/**/*.ts",
    "global-setup.ts",
    "paths.ts",
    "playwright.config.ts",
    "extension.playwright.config.ts",
    "pwa.playwright.config.ts",
    "visual.playwright.config.ts",
    "staging/**/*.ts"
  ],
  "exclude": [".artifacts", "node_modules", "eslint.config.mjs"],
  "references": [
    {
      "path": "../packages/shared"
    }
  ]
}
