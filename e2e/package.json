{
  "name": "@stxapps/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:e2e",
      "platform:agnostic"
    ],
    "targets": {
      "e2e-web": {
        "cache": false
      },
      "e2e-mobile": {
        "cache": false
      },
      "e2e-contract": {
        "cache": false
      },
      "seed": {
        "cache": false
      },
      "seed:fixtures": {
        "cache": false
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "e2e-web": "playwright test",
    "e2e-web:headed": "playwright test --headed",
    "e2e-web:report": "playwright show-report .artifacts/report",
    "e2e-mobile": "tsx runner/mobile.ts",
    "e2e-contract": "tsx runner/web-to-mobile.ts && tsx runner/mobile-to-web.ts",
    "seed": "tsx seed/seed.ts",
    "seed:fixtures": "tsx seed/generate.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stxapps/shared": "*",
    "fflate": "^0.8.2"
  }
}
