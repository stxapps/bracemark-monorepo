{
  "name": "@stxapps/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:e2e",
      "platform:agnostic"
    ],
    "targets": {
      "check:runner": {
        "cache": false
      },
      "check:browser": {
        "cache": false
      },
      "check:headers": {
        "cache": false
      },
      "e2e-web": {
        "cache": false
      },
      "e2e-pwa": {
        "cache": false
      },
      "e2e-extension": {
        "cache": false
      },
      "e2e-mobile": {
        "cache": false
      },
      "e2e-contract": {
        "cache": false
      },
      "e2e-visual": {
        "cache": false
      },
      "build-release:staging": {
        "cache": false
      },
      "e2e-web:staging": {
        "cache": false
      },
      "e2e-web:firefox": {
        "cache": false
      },
      "e2e-web:firefox:staging": {
        "cache": false
      },
      "e2e-extension:staging": {
        "cache": false
      },
      "e2e-mobile:staging": {
        "cache": false
      },
      "e2e-contract:staging": {
        "cache": false
      },
      "seed:fixtures": {
        "cache": false
      },
      "seed:accounts": {
        "cache": false
      },
      "shot:preflight": {
        "cache": false
      },
      "shot:account": {
        "cache": false
      },
      "shot:web": {
        "cache": false
      },
      "shot:ext": {
        "cache": false
      },
      "shot:mobile": {
        "cache": false
      },
      "measure:data": {
        "cache": false
      },
      "measure:native": {
        "cache": false
      },
      "measure:password-manager": {
        "cache": false
      },
      "measure:sync": {
        "cache": false
      },
      "measure:sync:staging": {
        "cache": false
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:registry": "tsx runner/registry.ts --check",
    "check:runner": "node --import tsx --test runner/*.test.ts",
    "check:browser": "node --import tsx --test staging/*.test.ts",
    "check:headers": "tsx staging/headers.ts",
    "e2e-web": "tsx runner/web.ts",
    "e2e-web:report": "tsx runner/web-report.ts",
    "e2e-pwa": "tsx runner/pwa.ts",
    "e2e-extension": "tsx runner/extension.ts",
    "e2e-mobile": "tsx runner/mobile.ts",
    "e2e-contract": "tsx runner/contract.ts",
    "e2e-visual": "tsx runner/visual.ts",
    "build-release:staging": "tsx runner/release-build.ts",
    "e2e-web:staging": "E2E_ENVIRONMENT=staging tsx runner/web.ts",
    "e2e-web:firefox": "E2E_BROWSER=firefox tsx runner/web.ts",
    "e2e-web:firefox:staging": "E2E_ENVIRONMENT=staging E2E_BROWSER=firefox tsx runner/web.ts",
    "e2e-extension:staging": "E2E_ENVIRONMENT=staging tsx runner/extension.ts",
    "e2e-mobile:staging": "E2E_ENVIRONMENT=staging tsx runner/mobile.ts",
    "e2e-contract:staging": "E2E_ENVIRONMENT=staging tsx runner/contract.ts",
    "seed:fixtures": "tsx seed/fixtures.ts",
    "seed:accounts": "tsx seed/accounts.ts",
    "shot:preflight": "tsx shot/preflight.ts",
    "shot:account": "tsx shot/account.ts",
    "shot:web": "tsx shot/web.ts",
    "shot:ext": "tsx shot/extension.ts",
    "shot:mobile": "tsx shot/mobile.ts",
    "measure:data": "tsx measure/data.ts",
    "measure:native": "tsx measure/native.ts",
    "measure:password-manager": "tsx measure/password-manager.ts",
    "measure:sync": "tsx measure/sync.ts",
    "measure:sync:staging": "E2E_ENVIRONMENT=staging tsx measure/sync.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stxapps/shared": "*",
    "fflate": "^0.8.2"
  }
}
