{
  "name": "@stxapps/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:e2e",
      "platform:agnostic"
    ],
    "targets": {
      "e2e-web": {
        "cache": false
      },
      "e2e-mobile": {
        "cache": false
      },
      "e2e-contract": {
        "cache": false
      },
      "seed:fixtures": {
        "cache": false
      },
      "seed:accounts": {
        "cache": false
      },
      "shot:preflight": {
        "cache": false
      },
      "shot:account": {
        "cache": false
      },
      "shot:web": {
        "cache": false
      },
      "shot:ext": {
        "cache": false
      },
      "shot:mobile": {
        "cache": false
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "e2e-web": "playwright test",
    "e2e-web:headed": "playwright test --headed",
    "e2e-web:report": "playwright show-report .artifacts/report",
    "e2e-mobile": "tsx runner/mobile.ts",
    "e2e-contract": "tsx runner/vectors.ts && tsx runner/web-to-mobile.ts && tsx runner/mobile-to-web.ts",
    "seed:fixtures": "tsx seed/fixtures.ts",
    "seed:accounts": "tsx seed/accounts.ts",
    "shot:preflight": "tsx shot/preflight.ts",
    "shot:account": "tsx shot/account.ts",
    "shot:web": "tsx shot/web.ts",
    "shot:ext": "tsx shot/extension.ts",
    "shot:mobile": "tsx shot/mobile.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stxapps/shared": "*",
    "fflate": "^0.8.2"
  }
}
